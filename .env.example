# Copia este archivo a .env.local para desarrollo.

# Neon → proyecto "cfscl" → Connect → rama main, base cfscl, "Connection pooling" activado
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-pooler.sa-east-1.aws.neon.tech/cfscl?sslmode=require

# Login con Google (cliente OAuth "Aplicación web" creado en GCP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=          # openssl rand -base64 32

# Correos que entran como administradores aunque no estén en la tabla usuarios
ADMIN_EMAILS=da.morande@gmail.com,francisco@cfs.cl

# Documentos: bucket privado de Cloud Storage. Vacío = carpeta local .uploads/
GCS_BUCKET=

# Llave para la API /api/v1 (agente de correos, MCP)
API_KEY=

# Solo desarrollo: entra sin Google como administrador
AUTH_DEV_BYPASS=0
